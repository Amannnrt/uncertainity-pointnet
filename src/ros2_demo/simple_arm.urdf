<?xml version="1.0"?>
<robot name="simple_arm">

  <!-- Base: fixed to the world -->
  <link name="base_link">
    <visual>
      <geometry><cylinder radius="0.15" length="0.1"/></geometry>
      <material name="grey"><color rgba="0.4 0.4 0.4 1"/></material>
    </visual>
  </link>

  <!-- Shoulder: rotates the whole arm left/right (pan) -->
  <link name="shoulder_link">
    <visual>
      <geometry><box size="0.1 0.1 0.15"/></geometry>
      <origin xyz="0 0 0.075"/>
      <material name="blue"><color rgba="0.2 0.3 0.8 1"/></material>
    </visual>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- Upper arm: lifts up/down -->
  <link name="upper_arm_link">
    <visual>
      <geometry><box size="0.08 0.08 0.6"/></geometry>
      <origin xyz="0 0 0.3"/>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.15"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>

  <!-- Forearm: elbow bend -->
  <link name="forearm_link">
    <visual>
      <geometry><box size="0.06 0.06 0.5"/></geometry>
      <origin xyz="0 0 0.25"/>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.6"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10" velocity="1"/>
  </joint>

  <!-- Gripper base -->
  <link name="gripper_link">
    <visual>
      <geometry><box size="0.1 0.1 0.08"/></geometry>
      <origin xyz="0 0 0.04"/>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="wrist_joint" type="fixed">
    <parent link="forearm_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.5"/>
  </joint>

  <!-- Two fingers that open/close -->
  <link name="finger_left">
    <visual>
      <geometry><box size="0.02 0.02 0.1"/></geometry>
      <origin xyz="0 0 0.05"/>
      <material name="red"><color rgba="0.9 0.2 0.2 1"/></material>
    </visual>
  </link>
  <joint name="gripper_left_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child link="finger_left"/>
    <origin xyz="0 0.06 0.08"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0" upper="0.05" effort="10" velocity="1"/>
  </joint>

  <link name="finger_right">
    <visual>
      <geometry><box size="0.02 0.02 0.1"/></geometry>
      <origin xyz="0 0 0.05"/>
      <material name="red"/>
    </visual>
  </link>
  <joint name="gripper_right_joint" type="prismatic">
    <parent link="gripper_link"/>
    <child link="finger_right"/>
    <origin xyz="0 -0.06 0.08"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="0.05" effort="10" velocity="1"/>
  </joint>

</robot>
